# Settings for docker compose. Do not edit this file with real values.
# Run   python scripts/make_env.py   to create your own .env from it, with freshly generated secrets.
# .env is in .gitignore and must never be committed.

# Leave at 50000 on Windows and macOS. On Linux set it to the output of:  id -u
AIRFLOW_UID=50000

# Login for the Airflow web page at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME

# Secrets. make_env.py replaces every CHANGE_ME with a random value.
FERNET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
AIRFLOW_DB_PASSWORD=CHANGE_ME

# The warehouse (the weather database). From your PC: localhost, port WAREHOUSE_PORT.
WAREHOUSE_USER=fairfield
WAREHOUSE_PASSWORD=CHANGE_ME
WAREHOUSE_DB=fairfield_weather
WAREHOUSE_PORT=5433
